<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Paradise.Editor</RootNamespace>
    <AssemblyName>Paradise.Editor</AssemblyName>
    <!-- Szenen-Editor (F1 > Open Editor): Hierarchy + Inspector laufen wie der Flash-Browser
         im Spielprozess auf einem eigenen STA-UI-Thread. -->
