<Window x:Class="Paradise.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paradise Engine – Launcher" Height="520" Width="860"
        WindowStartupLocation="CenterScreen" Background="#1b1d22">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e6e6e6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="PARADISE ENGINE" FontSize="20" FontWeight="Bold" Foreground="#5ad1b0" DockPanel.Dock="Left"/>
            <Button x:Name="RefreshButton" Content="Aktualisieren" DockPanel.Dock="Right" Padding="12,4" Click="OnRefresh"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Text=""/>
        </DockPanel>

        <!-- Serverliste -->
        <DataGrid x:Name="ServerGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#23262d" RowBackground="#23262d" AlternatingRowBackground="#282c34"
                  Foreground="#e6e6e6" BorderBrush="#33373f"
                  SelectionMode="Single" MouseDoubleClick="OnConnect">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Mod-Message" Binding="{Binding ModMessage}" Width="*"/>
                <DataGridTextColumn Header="Spieler" Binding="{Binding Players}" Width="90"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"/>
                <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Fußzeile -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock Text="Spielername:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
            <TextBox x:Name="NameBox" Width="160" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button x:Name="ConnectButton" Content="Verbinden" DockPanel.Dock="Right"
                    Padding="18,6" FontWeight="Bold" Click="OnConnect"/>
            <Button x:Name="SettingsButton" Content="Einstellungen" DockPanel.Dock="Right"
                    Padding="12,6" Margin="0,0,8,0" Click="OnSettings"/>
        </DockPanel>
    </Grid>
</Window>
