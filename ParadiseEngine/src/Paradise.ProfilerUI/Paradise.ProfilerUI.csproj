<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Paradise.ProfilerUI</RootNamespace>
    <AssemblyName>Paradise.ProfilerUI</AssemblyName>
    <!-- Profiler-Fenster (F1 > Performance > Open Profiler): läuft wie der Flash-Browser im Spielprozess
         auf einem eigenen STA-UI-Thread. Namespace bewusst nicht "Paradise.Profiler", sonst verdeckt er
         die Klasse Paradise.Core.Diagnostics.Profiler in allen Paradise.*-Namespaces. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Core\Paradise.Core.csproj" />
  </ItemGroup>

</Project>
