<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Flash-Browser (WinForms) läuft im Spielprozess – deshalb Windows-TFM wie der Launcher. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Paradise.Game</RootNamespace>
    <AssemblyName>Test Drive Unlimited 2</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe-/App-Icon (Explorer, Verknüpfung, Fenster). game.ico liegt im Hauptordner. -->
    <ApplicationIcon Condition="Exists('..\..\game.ico')">..\..\game.ico</ApplicationIcon>
    <Copyright>(C) 2026 by KuxiiSoft</Copyright>
    <Title>Test Drive Unlimited 2 Custom Engine</Title>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <!-- embedded statt none: ohne PDB stehen im Crash-Report nur Funktionsnamen,
         aber keine Datei-/Zeilenangaben. Die PDB liegt in der DLL (auch in der
         Single-File-exe), es wird keine zusätzliche Datei benötigt. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <!-- embedded statt none: ohne PDB stehen im Crash-Report nur Funktionsnamen,
         aber keine Datei-/Zeilenangaben. Die PDB liegt in der DLL (auch in der
         Single-File-exe), es wird keine zusätzliche Datei benötigt. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Core\Paradise.Core.csproj" />
    <ProjectReference Include="..\Paradise.FlashDebug\Paradise.FlashDebug.csproj" />
    <ProjectReference Include="..\Paradise.Editor\Paradise.Editor.csproj" />
    <ProjectReference Include="..\Paradise.ProfilerUI\Paradise.ProfilerUI.csproj" />
  </ItemGroup>

  <!-- Keine WinForms-Implizit-Usings im Spiel: "Screen" ist sonst mehrdeutig
       (Paradise.Core.Flash.Screen vs. System.Windows.Forms.Screen). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Speicherbereinigung: Streaming erzeugt viel Müll im Large Object Heap (Bänke, Netze). Standard-GC räumt den erst bei
       seltenen Gen2-Läufen und gibt kaum Speicher zurück (Prozess wuchs auf > 7 GB). ConserveMemory: öfter Gen2 + LOH verdichten. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <!-- Start-Logo (GAME_MODE_BOOTMENU) in die exe einbetten: ParadiseEngine\startup.png -->
  <ItemGroup Condition="Exists('..\..\startup.png')">
    <EmbeddedResource Include="..\..\startup.png" LogicalName="startup.png" />
  </ItemGroup>

  <!-- game.ico (liegt im ParadiseEngine-Hauptordner) als Fallback neben die exe. -->
  <ItemGroup Condition="Exists('..\..\game.ico')">
    <None Include="..\..\game.ico" Link="game.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
